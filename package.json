{
  "name": "dalil-alalab",
  "version": "0.1.0",
  "private": true,
  "description": "دليل الألعاب: طبقة مرافقة عربية للأهالي فوق أدوات الرقابة الأبوية",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:index && NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "npm run validate:data && npm run build:index && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "build:index": "tsx scripts/build-index.ts",
    "export:schema": "tsx scripts/export-json-schema.ts",
    "new-title": "tsx scripts/new-title.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "format": "prettier --write .",
    "import:verified": "tsx scripts/import-verified.ts",
    "seed:real": "tsx scripts/seed-real-titles.ts",
    "fetch:official": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx scripts/fetch-official.ts",
    "apply:official": "tsx scripts/apply-official.ts",
    "audit:shots": "tsx scripts/audit-shots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "fuse.js": "^7.5.0",
    "next": "^15.5.27",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
