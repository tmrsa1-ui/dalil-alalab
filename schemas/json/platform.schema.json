{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "playstation",
        "xbox",
        "switch",
        "pc"
      ]
    },
    "nameAr": {
      "type": "string",
      "minLength": 1
    },
    "nameEn": {
      "type": "string",
      "minLength": 1
    },
    "toolNameEn": {
      "type": "string",
      "minLength": 1
    },
    "officialGuideUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "officialGuideTitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifiedAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "linkCheckedAt": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "pointKey": {
            "type": "string",
            "enum": [
              "strangerChat",
              "purchases",
              "content",
              "ads",
              "sessionPause",
              "searchAndStore"
            ]
          },
          "stepAr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "verifiedAt": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "isDemo": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "pointKey",
          "stepAr",
          "sourceUrl",
          "verifiedAt",
          "isDemo"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "nameAr",
    "nameEn",
    "toolNameEn",
    "officialGuideUrl",
    "officialGuideTitle",
    "verifiedAt",
    "linkCheckedAt",
    "steps"
  ],
  "additionalProperties": false
}
