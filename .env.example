# كل المتغيرات اختيارية. المنتج يشتغل كامل بدونها.

# الذكاء الاصطناعي (اختياري) — توليد بطاقة «آلية بمصادر» لعنوان غير موجود
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ENABLE_AI_CARDS=false
MAX_AI_CARDS_PER_DAY=20

# Supabase (اختياري) — تخزين الأحداث المجهولة وطلبات الإضافة. بدونه: ملف محلي في dev، وتعطيل هادئ في production
# (وبدونه ما يظهر زر «اطلب إضافته» أصلًا، عشان ما نوعد بشي ما ينحفظ).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# مفتاح الخدمة (server-only، لا يصل للمتصفح أبدًا): تقرأ به صفحة /about/impact الأرقام المجمّعة فقط
# (impact_summary و feedback_summary). بدونه تعرض الصفحة «لم يُقَس بعد».
SUPABASE_SERVICE_ROLE_KEY=
# لتشغيل التخزين في ملف محلي (.data/) حتى في وضع الإنتاج (للعرض المحلي فقط)
# DALIL_LOCAL_SINK=1

# رابط الموقع العام (للـQR في صفحة الطباعة والـmetadata)
NEXT_PUBLIC_SITE_URL=
