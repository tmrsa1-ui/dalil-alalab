# كل المتغيرات اختيارية. المنتج يشتغل كامل بدونها.

# الذكاء الاصطناعي (اختياري) — توليد بطاقة «آلية بمصادر» لعنوان غير موجود
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ENABLE_AI_CARDS=false
MAX_AI_CARDS_PER_DAY=20

# Supabase (اختياري) — تخزين الأحداث المجهولة. بدونه: ملف محلي في dev، وتعطيل هادئ في production
SUPABASE_URL=
SUPABASE_ANON_KEY=

# رابط الموقع العام (للـQR في صفحة الطباعة والـmetadata)
NEXT_PUBLIC_SITE_URL=
